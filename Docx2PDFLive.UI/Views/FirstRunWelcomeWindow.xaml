<Window x:Class="Docx2PDFLive.UI.Views.FirstRunWelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Docx2PDF"
        Height="430" Width="510"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        WindowStyle="SingleBorderWindow"
        Icon="/Resources/app_icon.png">
    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Icon -->
        <Image Grid.Row="0"
               Source="/Resources/app_icon.png"
               Width="84" Height="84"
               HorizontalAlignment="Center"
               Margin="0,0,0,16"/>

        <!-- Title & Creator Credit -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="Docx2PDF"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"
                       HorizontalAlignment="Center"/>
            <Border Background="#1E293B"
                    CornerRadius="12"
                    Padding="10,4"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0">
                <TextBlock Text="Created by Akib"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#38BDF8"/>
            </Border>
        </StackPanel>

        <!-- 2-Line Overview -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="This app was made after GTA6 by Akib Hasan Saif."
                       FontSize="13.5"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Real-time background folder monitoring and DOCX to PDF conversion."
                       FontSize="13"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- LibreOffice info / optional button -->
        <Border Grid.Row="3"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                VerticalAlignment="Center">
            <TextBlock Text="Automatic real-time syncing. Keeps your PDF documents up to date."
                       FontSize="11.5"
                       Foreground="#64748B"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Action Button -->
        <Button Grid.Row="4"
                Content="Get Started"
                Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True"
                HorizontalAlignment="Center"
                Width="220"
                Margin="0,20,0,0"
                Click="GetStartedButton_Click"/>
    </Grid>
</Window>
